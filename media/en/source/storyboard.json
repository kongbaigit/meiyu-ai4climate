  "text_cues": [
    {
      "start": 0.0,
      "end": 5.2747673488780515,
      "text": "Move the stock?"
    },
    {
      "start": 5.2747673488780515,
      "end": 15.824302046634156,
      "text": "Public forecasts and station references form 636 paired historical days."
    },
    {
      "start": 15.824302046634156,
      "end": 26.373836744390257,
      "text": "Each row pairs a forecast and reference for the same 24-hour UTC window."
    },
    {
      "start": 26.373836744390257,
      "end": 39.56075511658538,
      "text": "The frozen historical model estimates a rainfall reference event. It is an offline experiment."
    },
    {
      "start": 39.56075511658538,
      "end": 50.11028981434149,
      "text": "51 ensemble members, 24 hourly values each. A recorded forecast snapshot, not a loss probability."
    },
    {
      "start": 50.11028981434149,
      "end": 55.38505716321954,
      "text": "Every member and hour must be complete. Missing values are never replaced with zero."
    },
    {
      "start": 55.38505716321954,
      "end": 61.978516349317104,
      "text": "Hypothetical example: p=60%, relocation CNY 80, conditional losses CNY 1,000 and 100."
    },
    {
      "start": 61.978516349317104,
      "end": 68.57197553541467,
      "text": "Expected totals: keep CNY 600; relocate CNY 140. The difference of CNY 460 is simulated."
    },
    {
      "start": 68.57197553541467,
      "end": 76.48412655873175,
      "text": "Break-even relocation cost: CNY 540. At CNY 600, keeping the goods costs less."
    },
    {
      "start": 76.48412655873175,
      "end": 81.7588939076098,
      "text": "Save assumptions, calculation mode, results and forecast sources in a local record."
    },
    {
      "start": 81.7588939076098,
      "end": 87.03366125648785,
      "text": "Meiyu Prepare. Compare costs. Decide what to move."
    }
  ],
  "beat_seconds": 0.6593459186097564,
