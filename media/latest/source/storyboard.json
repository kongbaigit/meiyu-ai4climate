  "text_cues": [
    {
      "start": 0.3296729593048782,
      "end": 4.945094389573173,
      "text": "雨要来了。这批货，搬不搬？"
    },
    {
      "start": 5.2747673488780515,
      "end": 12.69240893323781,
      "text": "公开预报与站点参考，保留来源再按时间窗配对。"
    },
    {
      "start": 13.186918372195128,
      "end": 20.60455995655489,
      "text": "636个完整配对日，每行保留窗口、雨量和质量状态。"
    },
    {
      "start": 21.099069395512203,
      "end": 23.73645306995123,
      "text": "历史离线实验按时间分开训练、验证和测试。"
    },
    {
      "start": 23.73645306995123,
      "end": 31.31893113396343,
      "text": "预报雨量经过特征变换与标准化，进入逻辑回归。"
    },
    {
      "start": 31.64860409326831,
      "end": 36.92337144214636,
      "text": "当前集合预报展开为51成员乘24小时矩阵。"
    },
    {
      "start": 36.92337144214636,
      "end": 39.39591863693295,
      "text": "逐成员累计，统计达到25毫米的成员占比。"
    },
    {
      "start": 39.56075511658538,
      "end": 44.176176546853675,
      "text": "缺失情景演示：少一个小时，暂停当前建议。"
    },
    {
      "start": 44.83552246546344,
      "end": 50.11028981434148,
      "text": "算账示例假设事件概率60%，确认三项成本。"
    },
    {
      "start": 50.11028981434148,
      "end": 55.05538420391466,
      "text": "不搬预计600元，搬货预计140元，相差460元。"
    },
    {
      "start": 55.38505716321954,
      "end": 60.65982451209759,
      "text": "搬货费升到540元时，两种选择同价。"
    },
    {
      "start": 60.65982451209759,
      "end": 63.13237170688418,
      "text": "搬货费600元时，不搬预计600元，搬货预计660元。"
    },
    {
      "start": 63.29720818653662,
      "end": 68.2423025761098,
      "text": "模式、假设和计算结果，一起保存在本次账单。"
    },
    {
      "start": 68.57197553541467,
      "end": 73.51706992498784,
      "text": "梅雨有数。算清成本，再决定搬不搬。"
    }
  ],
