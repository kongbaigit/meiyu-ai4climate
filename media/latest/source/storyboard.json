  "text_cues": [
    {
      "start": 0.9,
      "end": 5.5,
      "text": "先看天气，再算准备成本。",
      "accent": "准备成本"
    },
    {
      "start": 6.7,
      "end": 10.7,
      "text": "自动获取天气，先核对完整度。",
      "accent": "完整度"
    },
    {
      "start": 11.1,
      "end": 15.5,
      "text": "数据过期或缺失，暂停当前建议。",
      "accent": "暂停当前建议"
    },
    {
      "start": 16.7,
      "end": 21.3,
      "text": "搬一次的成本 + 这类降雨下的平均货损",
      "accent": "平均货损"
    },
    {
      "start": 22.0,
      "end": 27.4,
      "text": "搬后仍可能受损，这笔损失也要算。",
      "accent": "也要算"
    },
    {
      "start": 28.7,
      "end": 32.7,
      "text": "不搬预计 ¥600，搬货预计 ¥140。",
      "accent": "¥140"
    },
    {
      "start": 33.2,
      "end": 37.5,
      "text": "按这些假设，搬货的预计总成本更低。",
      "accent": "预计总成本更低"
    },
    {
      "start": 38.4,
      "end": 40.8,
      "text": "搬货成本：80 → 600元。",
      "accent": "80 → 600"
    },
    {
      "start": 41.2,
      "end": 46.4,
      "text": "搬货预计 ¥660，不搬预计 ¥600。",
      "accent": "¥600"
    },
    {
      "start": 47.6,
      "end": 51.2,
      "text": "确认准备项，保留本次成本假设。",
      "accent": "成本假设"
    },
    {
      "start": 51.6,
      "end": 54.6,
      "text": "天气、窗口和选择，一起记入账单。",
      "accent": "记入账单"
    },
    {
      "start": 56.0,
      "end": 59.7,
      "text": "打开应用，算一算你的搬货成本。",
      "accent": "搬货成本"
    }
  ]
